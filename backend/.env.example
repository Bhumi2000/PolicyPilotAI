# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file or your API key to Git.

# Google Gemini API key (get one free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Gemini model to use
GEMINI_MODEL=gemini-3.5-flash

# Sampling temperature for the model (0.0 = deterministic, 1.0 = creative)
GEMINI_TEMPERATURE=0.2

# When true and no API key is set, the backend answers with clearly-labelled
# deterministic demo output so the UI can be explored offline.
# Leave false for real evaluations.
ENABLE_DEMO_MODE=false

# Comma separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
